rules_version = '2';

// Reglas de Cloud Firestore para Primal Echo (juego, PWA y app de Android).
// Cada jugador solo puede leer y escribir su propio documento.
service cloud.firestore {
  match /databases/{database}/documents {

    match /jugadores/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Novedades del proyecto: cualquiera las lee; se editan desde la consola de Firebase.
    match /novedades/{id} {
      allow read: if true;
      allow write: if false;
    }
  }
}
