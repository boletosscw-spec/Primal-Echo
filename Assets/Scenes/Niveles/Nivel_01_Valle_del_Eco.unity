  m_Script: {fileID: 11500000, guid: fd31d99c1fcc8064b9e6df53d18492d8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  lineas:
  - "Alto. \xBFViste una onda cian desde el risco?"
  - "Soy Orin. Reparaba los sensores de N\xC9MESIS. Este peque\xF1o todav\xEDa reconoce
    su se\xF1al."
  - "Lo saqu\xE9 de entre los escombros. Tiene un contacto suelto y me tiemblan las
    manos."
  - "Kael: Vigila tu esc\xE1ner. Yo ajusto el contacto."
  - '#REPARAR'
  - "Ya se mueve. Espera... est\xE1 buscando de d\xF3nde vino la onda."
  - "Kael: Kiro. \xBFTe parece? Vamos a seguir esa se\xF1al."
  - "Marc\xF3 el este. Sigue el valle. Te espero en la entrada de la cueva."
  radio: 6.5
  desaparece: 1
  visual: {fileID: 1570074762}
  quieto:
    textura: {fileID: 2800000, guid: f96d52f4fc224fae944d385f1a1015d5, type: 3}
